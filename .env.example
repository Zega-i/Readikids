# Salin file ini menjadi `.env` lalu isi nilai kamu.

# ── Supabase (backend online) ─────────────────────────────────────────────
# Ambil dari dashboard Supabase -> Settings -> API.
#   VITE_SUPABASE_URL      : URL project (base, tanpa /rest/v1/)
#   VITE_SUPABASE_ANON_KEY : publishable/anon key (aman di browser, dijaga RLS)
#   SUPABASE_SECRET_KEY    : secret/service key — HANYA server, TANPA awalan VITE_
# Wajib aktifkan: Authentication -> Providers -> Anonymous (default mati).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# ── AI Rencana Pendampingan via OpenRouter (server-only) ──────────────────
# Dipakai serverless function api/companion-plan.ts (bukan frontend).
# TANPA awalan VITE_ (jangan sampai ter-bundle ke browser).
#   OPENROUTER_API_KEY : key dari https://openrouter.ai/keys
#   OPENROUTER_MODEL   : slug model, mis. nvidia/nemotron-3-ultra-550b-a55b:free
# Di produksi, isi keduanya di Vercel -> Settings -> Environment Variables.
# Jika kosong / proxy tak tersedia, sistem otomatis memakai template lokal.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ── (Opsional) Override URL proxy AI untuk dev ────────────────────────────
# VITE_AI_PROXY_URL=/api/companion-plan
